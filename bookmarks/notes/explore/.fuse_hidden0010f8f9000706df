    max_connections=50,
    decode_responses=True
)
redis_client = redis.Redis(connection_pool=pool)
</code></pre>
<hr />
<h2 id="_4">故障恢复</h2>
<h3 id="1_1">1. 状态快照</h3>
<pre><code class="language-python">def save_snapshot(account_id: str):
    positions = []
    for lot_id in redis.smembers(f'account:{account_id}:positions'):
        lot_data = redis.hgetall(f'lot:{lot_id}')
        positions.append(lot_data)

    snapshot = {
        'account_id': account_id,
        'positions': positions,
        'timestamp': time.time()
    }

    redis.setex(
        f'account:{account_id}:snapshot',
        3600,  # 1 小时过期
        json.dumps(snapshot)
    )
</code></pre>
<h3 id="2_1">2. 恢复流程</h3>
<pre><code class="language-python">def restore_from_snapshot(account_id: str):
    snapshot_json = redis.get(f'account:{account_id}:snapshot')
    if not snapshot_json:
        return None

    snapshot = json.loads(snapshot_json)

    # 恢复持仓
    for lot_data in snapshot['positions']:
        lot_id = lot_data.pop('lot_id')
        redis.hmset(f'lot:{lot_id}', lot_data)
        redis.sadd(f'account:{account_id}:positions', lot_id)

    return snapshot
</code></pre>
