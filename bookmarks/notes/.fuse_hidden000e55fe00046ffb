│   ├── dr_gen.py               # 报告生成（元数据/引用转换/装配）
│   └── lang_config.py          # 19 语言配置表（~540行）
├── prompts/
│   ├── task1_oracle.md         # Task 1 主题分析 prompt
│   ├── task2_data_collection.md # Task 2 数据收集 prompt
│   └── task3_chapter_agent.md  # Task 3 章节撰写 prompt
├── command/                    # slash command 注册
│   └── research.md
