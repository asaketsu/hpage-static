<h2 id="5">5. 关键代码模式</h2>
<h3 id="51">5.1 原子文件写入（跨平台安全）</h3>
<pre><code class="language-python">tmp = filepath + '.tmp'
with open(tmp, 'w', encoding='utf-8', newline='\n') as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
os.replace(tmp, filepath)  # 原子操作
</code></pre>
<h3 id="52">5.2 引用编号预分配</h3>
<pre><code class="language-python"># 按首次出现顺序分配 [1], [2], [3]...
seen = set()
for rec in data:
    for fact in rec['facts']:
        key = (fact['src'], fact['yr'])
        if key not in seen:
            seen.add(key)
            ordered_refs.append(key)
ref_map = {pair: i + 1 for i, pair in enumerate(ordered_refs)}
</code></pre>
<h3 id="53">5.3 并行章节验证</h3>
<pre><code class="language-python">from concurrent.futures import ThreadPoolExecutor
with ThreadPoolExecutor(max_workers=min(chapter_count, 8)) as ex:
    futures = {}
    for i in range(1, chapter_count + 1):
        path = os.path.join(chapters_dir, f&quot;chapter-{i}.md&quot;)
        futures[ex.submit(validate_chapter, path, expected)] = i
</code></pre>
